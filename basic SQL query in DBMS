
#1. Employee Table Creation
CREATE TABLE emp(
    id INT PRIMARY KEY,
    name VARCHAR(30),
    surname VARCHAR(30),
    gender CHAR(1),
    age INT,
    area VARCHAR(30),
    DOJ DATE,
    salary INT
);


